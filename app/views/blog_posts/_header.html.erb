          <%= link_to "Your Profile", edit_user_registration_path, class: "font-bold"%>
          
          <%= button_to "Logout",
              destroy_user_session_path,
              method: :delete,
              class: "bg-gray-100 px-4 py-2 rounded hover:bg-gray-200" %>
        <%end%>
    </div>
    
  </div>
