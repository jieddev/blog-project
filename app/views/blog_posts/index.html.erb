<div >
    <h1 class="text-4xl font-bold text-amber-300 " >Blogs</h1>
    <%= link_to "Create a new post", new_blog_post_path, class: "underline" %>
  </div>

<div class="width-max post-form-wrap pt-16 mt-16 mb-12"> 
  
  <% @blog_posts.each do |blog_post| %>
    <strong><%= link_to blog_post.title, blog_post , class: "underline"%></strong>
    <%= blog_post.content %> <br>
  <%end%>

  
  <% if @pagy.count > @pagy.limit %>
    <%== @pagy.series_nav(:bootstrap) %>
  <%end%>
</div>
