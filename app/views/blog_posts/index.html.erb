<div class="mb-10 p-12">
  <h1 class="text-4xl text-gray-500 font-bold" >FaceBlogs</h1>
  <p>Total Users: <%= @total_users %></p>
  <p>Total Posts: <%= BlogPost.count %></p>

  <%= link_to "Create a new post", new_blog_post_path, class: "underline" %>
  
</div>

<div> 
  <div>
      <% @blog_posts.each do |blog_post| %>

        <div class="card mb-10" style="width: 40rem;">
          <div class="card-body">
            <div >
              <h5 class="card-title "><strong><%= link_to blog_post.title, blog_post , class: "text-decoration-none"%></strong></h5>
              <%= blog_post.published_at%>
              <% if blog_post.user_id == current_user.id %>
                <p class="card-text">By: <%= current_user.email %></p>
              <% elsif blog_post.user_id != current_user.id %>
                <p class="card-text">By: <%= link_to blog_post.user.email, user_path(blog_post.user_id), class: "text-decoration-none" %></p>
              <%elsif blog_post.user_id.nil? %>
                <p class="card-text">By: Anonymous</p>
              <%end%>
            </div>

            <p class="card-text"><%= blog_post.content %> </p>


            <div class="border-t border-gray-400 pt-2 flex">

              <%= turbo_frame_tag "like_button_#{blog_post.id}" do %>
                <%= render "likes/button", blog_post: blog_post%>

              <%end%>      
                <div data-controller="toggle">
                  
                  <div data-action="click->toggle#show">
                    <%= render "comments/button", blog_post: blog_post %>
                  </div>
                      
                  <div data-toggle-target="container" class="hidden">
                    <div class="card" style="width: 33rem;">
                      <div class="card-body">
                      
                        <% if blog_post.comments.any? %>
                          <% blog_post.comments.each do |comment| %>
                              <p class="card-text font-bold"> <%= comment.user.email %></p>
                              <p class="card-text"> <%= comment.body %></p>
                    
                          <%end%>
                        <% else %>
                            <p class="card-text"> No Comments yet.</p>
                        <%end%>

                        <%= form_with model: [blog_post, Comment.new], local: false do |f| %>
                          <div class="d-flex flex-start w-100">
                            <div data-mdb-input-init class="form-outline w-100">
                              <%= f.text_area :body, class: "form-control" %>
                            </div>
                          </div>
                          <div class="float-end mt-2 pt-1">
                            <%= f.submit "Post comment", class: "btn btn-primary btn-sm", data: { mdb_button_init: "", mdb_ripple_init: "" } %>
                            <%# <button  type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-sm">Post comment</button> %>
                            <button  type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-outline-primary btn-sm">Cancel</button>
                          </div>
                        <%end%>
                          
                          <br>      
                      </div>
                    </div>
                  </div>
                
                </div>
            </div>

            

          </div>
        </div>
      <%end%>

    
    <% if @pagy.count > @pagy.limit %>
      <%== @pagy.series_nav(:bootstrap) %>
    <%end%>
  </div>
</div>
