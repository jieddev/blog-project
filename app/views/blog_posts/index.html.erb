<div class="mb-10 p-12">
  <h1 class="text-4xl text-gray-500 font-bold " >Blog Posts</h1>
  <%= link_to "Create a new post", new_blog_post_path, class: "underline" %>
</div>

<div> 
  <% if params[:q].present? %>
    <p>Showing results for: <strong><%= params[:q] %></strong></p>
  <% end %>

  
  <div>
      <% @blog_posts.each do |blog_post| %>
        <div class="mb-10">
          <strong><%= link_to blog_post.title, blog_post , class: "underline"%></strong>
          <%= blog_post.content %> <br>
          <%= blog_post.published_at%> <br>

          <% if blog_post.user_id == current_user.id %>
            <p>By: <%= current_user.email%></p>
          <%else %>
            <p>By: Anonymous</p>
          <%end%>
        </div>
      <%end%>

    
    <% if @pagy.count > @pagy.limit %>
      <%== @pagy.series_nav(:bootstrap) %>
    <%end%>
  </div>
</div>
