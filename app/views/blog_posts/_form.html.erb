<%= form_with model: @blog_post do |f| %>
  <% if f.object.errors.any? %>
    <% f.object.errors.full_messages.each do |error_message|%>
      <%= error_message%>
    <%end%>
  <%end%>

  <div>
    <%= f.text_field :title, placeholder: "Title",class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div>
    <%= f.text_area :body, placeholder: "Body", class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div>
    <%= f.label :published_at %> <br>
    <%= f.datetime_select :published_at, include_blank: true, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <%= f.submit "Done", class: "bg-gray-100 px-4 py-2 rounded hover:bg-gray-200" %>

<%end%>