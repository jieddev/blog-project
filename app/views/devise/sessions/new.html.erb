<div class="mx-auto mt-12 w-full max-w-md rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
  <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Log in</h2>

  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-inputs">
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Log in" %>
    </div>
  <% end %>

  <div class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-700">
    <%= render "devise/shared/links" %>
  </div>
</div>